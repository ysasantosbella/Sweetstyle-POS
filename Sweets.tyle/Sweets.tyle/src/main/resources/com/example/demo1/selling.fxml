<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@selling.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.SellingController">
   <children>
      <HBox alignment="CENTER" layoutX="220.0" layoutY="40.0" prefHeight="620.0" prefWidth="954.0" spacing="30.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="26.0" AnchorPane.topAnchor="40.0">
         <children>
            <ScrollPane fx:id="ProductScrollPane" prefHeight="546.0" prefWidth="535.0">
               <content>
                  <VBox fx:id="productsList" prefHeight="605.0" prefWidth="464.0" stylesheets="@selling.css" />
               </content>
            </ScrollPane>
            <VBox alignment="CENTER" prefHeight="536.0" prefWidth="531.0" spacing="10.0" stylesheets="@selling.css">
               <children>
                  <ScrollPane fx:id="selectedProductScrollPane" prefHeight="546.0" prefWidth="531.0">
                     <content>
                        <VBox fx:id="selectedProductsList" prefHeight="509.0" prefWidth="434.0" stylesheets="@selling.css" />
                     </content>
                  </ScrollPane>
                  <HBox alignment="CENTER" prefHeight="29.0" prefWidth="460.0" spacing="200.0" stylesheets="@selling.css">
                     <children>
                        <Label fx:id="totalPrice" stylesheets="@selling.css" />
                     </children>
                  </HBox>
                  <Button fx:id="acceptOrderButton" mnemonicParsing="false" prefHeight="41.0" prefWidth="247.0" stylesheets="@selling.css" text="Confirm Order" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox fx:id="navigationPane" prefHeight="767.0" prefWidth="150.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-border-color: #ddd; -fx-border-width: 0 1 0 0;" stylesheets="@Inventory.css">
         <children>
            <HBox prefHeight="46.0" prefWidth="109.0" />
            <Button fx:id="inventoryButton" onAction="#goToInventory" prefWidth="110.0" style="-fx-background-color: #eec5de;" stylesheets="@Inventory.css" text="Inventory" />
            <Button fx:id="sellingButton" onAction="#goToSelling" prefWidth="110.0" style="-fx-background-color: #eec5de;" text="Selling" />
         </children>
      </VBox>
      <Button fx:id="menuToggleButton" layoutX="14.0" layoutY="20.0" onAction="#toggleSidebar" stylesheets="@Inventory.css" text="☰" />
   </children>
</AnchorPane>
